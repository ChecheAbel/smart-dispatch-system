PORT=4000
DATABASE_URL=postgres://postgres:password@localhost:5432/dispatch_db
JWT_SECRET=change-this-in-production
APP_URL=http://localhost:3000

# Driver license photo uploads (absolute path, outside project directory)
# Local dev example:
UPLOAD_ROOT=~/uploads/smart-dispatch
# Production example:
# UPLOAD_ROOT=/var/smart-dispatch/uploads

# Optional: seed an administrator on first startup
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=System Administrator

# Push notifications via external broadcast service
# Base URL only — the API appends /api/v1/notifications/broadcast and /api/v1/devices/tokens
# NOTIFICATION_BROADCAST_URL=http://localhost:4031
# NOTIFICATION_APPLICATION_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
# Optional: comma-separated channels (default: fcm)
# NOTIFICATION_BROADCAST_CHANNELS=fcm
# NOTIFICATION_BROADCAST_API_KEY=

# Business TIN lookup via eTrade registration
# ETRADE_REGISTRATION_URL=https://invoice-api-apiproxy-grykeb-14616c-196-188-249-221.sslip.io/bo-dev/api/etrade/registration
# Optional override; defaults to the sibling /license path of ETRADE_REGISTRATION_URL
# ETRADE_LICENSE_URL=https://invoice-api-apiproxy-grykeb-14616c-196-188-249-221.sslip.io/bo-dev/api/etrade/license
# Optional bearer token if the proxy requires one
# ETRADE_REGISTRATION_API_KEY=

# Customer invoice payment methods are configured in Admin → System Settings → Payment Gateway.

# Ride request client reminders (default: enabled, every 15 minutes)
# RIDE_REQUEST_REMINDER_ENABLED=true
# RIDE_REQUEST_REMINDER_INTERVAL_MS=900000
# RIDE_REQUEST_REMINDER_STARTUP_DELAY_MS=45000
